[Unit]
Description=RailDock Holocron documentation
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/raildock-site/docs
Environment=PORT=3000
ExecStart=/usr/bin/node dist/rsc/index.js
Restart=on-failure
RestartSec=3

# Sensible baseline hardening; test if you add features that need broader filesystem access.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
