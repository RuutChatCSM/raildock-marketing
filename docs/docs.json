{
  "$schema": "https://holocron.so/docs.json",
  "name": "RailDock Docs",
  "description": "Deploy and operate applications and databases on servers you control with RailDock.",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#8B5CF6",
    "dark": "#A78BFA"
  },
  "logo": {
    "light": "/raildock-logo.png",
    "dark": "/raildock-logo-on-dark.png"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/mona-chen/raildock"
      },
      {
        "label": "Website",
        "href": "/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "API Reference",
      "href": "/api-reference/"
    }
  },
  "search": {
    "prompt": "Search RailDock docs\u2026"
  },
  "assistant": {
    "enabled": true
  },
  "knownPaths": [
    "/",
    "/api-reference/",
    "/api-reference/*",
    "/platform/",
    "/platform/*",
    "/manifests/",
    "/manifests/*",
    "/reliability/",
    "/reliability/*",
    "/self-hosting/",
    "/self-hosting/*",
    "/open-source/",
    "/security/",
    "/compare/"
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "getting-started/install",
              "getting-started/first-project"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/architecture",
              "concepts/projects-environments",
              "concepts/services"
            ]
          },
          {
            "group": "Deploy applications",
            "pages": [
              "deploy/git",
              "deploy/docker",
              "deploy/deploy-sequence",
              "deploy/domains-ssl",
              "deploy/logs-terminal"
            ]
          },
          {
            "group": "Declarative manifests",
            "pages": [
              "manifests/overview",
              "manifests/reference",
              "manifests/variables-links",
              "manifests/reconciliation"
            ]
          },
          {
            "group": "Data & recovery",
            "pages": [
              "data/databases",
              "data/backups",
              "data/pitr",
              "data/destinations"
            ]
          },
          {
            "group": "Operate RailDock",
            "pages": [
              "operate/server-provisioning",
              "operate/networking",
              "operate/external-proxy",
              "operate/metrics"
            ]
          },
          {
            "group": "Teams & integrations",
            "pages": [
              "teams/organizations-rbac",
              "integrations/github"
            ]
          },
          {
            "group": "API & security",
            "pages": [
              "api/overview",
              "api/authentication",
              "security/data-safety"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "href": "/api-reference/"
      },
      {
        "tab": "GitHub",
        "href": "https://github.com/mona-chen/raildock"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "RailDock home",
          "href": "/",
          "icon": "house"
        }
      ]
    }
  }
}
